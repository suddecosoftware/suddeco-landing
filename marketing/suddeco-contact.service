[Unit]
Description=Suddeco marketing enquiry handler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
EnvironmentFile=/opt/suddeco/env/landing-contact.env
Environment=CONTACT_STATE_DIR=/var/lib/suddeco-contact
ExecStart=/usr/bin/node /opt/suddeco/landing/contact-service/contact-service.mjs
Restart=on-failure
RestartSec=5
StateDirectory=suddeco-contact
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
